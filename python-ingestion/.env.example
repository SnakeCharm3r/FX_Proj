# ── cTrader Open API credentials ──────────────────────────────────────────────
# Get these from connect.spotware.com → Applications
CLIENT_ID=YOUR_CLIENT_ID_HERE
CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Your Pepperstone cTrader account ID (shown in cTrader platform top-left)
ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE

# true = demo servers (demo.ctraderapi.com:5035)
# false = live servers (live.ctraderapi.com:5035)
DEMO=true

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Laravel API (for posting bars + ticks) ────────────────────────────────────
LARAVEL_API_URL=http://127.0.0.1:8000/api
LARAVEL_API_KEY=

# ── Instrument ────────────────────────────────────────────────────────────────
# Pepperstone symbol name for spot gold
SYMBOL=XAUUSD

# ── Timeframes to build bars for (comma-separated) ────────────────────────────
TIMEFRAMES=5m,15m,30m,1h,4h

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
