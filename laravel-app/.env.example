APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram setup alerts
# Paste the BotFather token here; keep it private.
TELEGRAM_BOT_TOKEN=
# Public channel: @your_channel_username; private channel: numeric chat ID.
TELEGRAM_CHAT_ID=
ALERT_CHANNELS=telegram
# Set true after filling in both Telegram values and testing delivery.
OF_EXTERNAL_ALERTS_ENABLED=false
# Telegram price-touch updates
ALERT_TP_UPDATES_ENABLED=true
# Stop-loss price-touch updates
ALERT_SL_UPDATES_ENABLED=true

# Retain completed-candle observations at or above this score.
OF_HISTORY_MIN_SCORE=45
SERVER_PORT=8003

# Require H1 demand/supply retest and rejection before setup alerts.
OF_SETUP_STRATEGY=h1_trend_range_v3
OF_ABSORPTION_EFFORT_LOOKBACK=4
OF_ABSORPTION_EFFORT_WICK_RATIO=0.4

# Persist compressed closed broker/footprint revisions for research replay.
OF_RESEARCH_ARCHIVE_ENABLED=true
OF_PARTICIPATION_LOOKBACK=20
OF_PARTICIPATION_MIN_SAMPLES=10
OF_PARTICIPATION_INCREASED_RATIO=1.5
OF_PARTICIPATION_DECREASED_RATIO=0.7
OF_PARTICIPATION_DELTA_SHARE=0.1
OF_PARTICIPATION_HISTORY_BARS=300
OF_SCALP_MIN_CONFLUENCE=60
OF_SCALP_DELTA_SHARE=0.10
OF_SCALP_MIN_DELTA_SHARE=0.05
OF_SCALP_TEST_CAPITAL=100
OF_SCALP_TEST_LOT=0.01
OF_XAU_CONTRACT_SIZE=100
OF_LIVE_MAX_STOP_POINTS=5.0
OF_VARIABLE_OPPORTUNITIES_ENABLED=false
OF_VARIABLE_MIN_RULES=25
OF_GC_SESSION_TIMEZONE=America/New_York
OF_GC_SESSION_OPEN=18:00
